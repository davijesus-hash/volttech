<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VoltTech - Login Administrativo</title>
    <link rel="shortcut icon" type="image/x-icon" href="/img/adm_favicon.ico">

    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/dashboard.css">
    <link rel="stylesheet" href="/css/login.css">
</head>

<body class="admin-body">

    <div class="login-wrapper">
        <div class="login-card">
            <h2>VoltTech Admin</h2>
            <p>Entre com suas credenciais para gerenciar o sistema</p>

            <% if (erro) { %>
                <div class="error-alert">
                    <%= erro %>
                </div>
                <% } %>

                    <form action="/login" method="POST" style="display: flex; flex-direction: column; gap: 16px;">
                        <div>
                            <label class="label-placeholder">E-mail</label>
                            <input type="email" name="email" placeholder="Digite seu E-mail" required
                                class="input-dash">
                        </div>
                        <div>
                            <label class="label-placeholder">Senha</label>
                            <input type="password" name="senha" placeholder="Digite sua senha" required
                                class="input-dash">
                        </div>
                        <button type="submit" class="btn-salvar" style="width: 100%; margin-top: 8px;">Entrar</button>
                    </form>
                    <div style="text-align: center; margin-top: 16px;">
                        <a href="/" style="font-size: 0.85rem; color: #64748b; text-decoration: none;">&larr; Voltar
                            para a loja</a>
                    </div>
        </div>
    </div>

</body>

</html>