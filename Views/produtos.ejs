<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VoltTech - Catálogo de Produtos</title>
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/produtos.css">
    
    <script src="https://unpkg.com/lucide@latest"></script>
</head>

<body>

    <header class="navbar">
        <div class="logo">
            <a href="/">
                <img src="/img/VoltTech.png" alt="Logo VoltTech" class="logo-icon">
                <h1>VoltTech</h1>
            </a>
        </div>
        <nav class="nav-links">
            <a href="/">Início</a>
            <a href="/produtos" class="active">Produtos</a>
            <a href="/#sobre">Sobre nós</a>
            <a href="/#contato">Contato</a>
        </nav>
        <a href="/admin/dashboard" class="btn-admin">Área Administrativa</a>
    </header>

    <!-- Barra de Filtros / Busca -->
    <section class="catalog-header">
        <div class="catalog-controls">
            <div class="filter-group">
                <button class="btn-filter"><i data-lucide="sliders-horizontal"></i> Ordenar:</button>
                <div class="search-select-wrapper">
                    <input type="text" placeholder="Ex: iPhone 11 Pro Max" class="search-input">
                    <i data-lucide="chevron-down" class="chevron-icon"></i>
                </div>
            </div>
            <div class="cart-summary">
                <i data-lucide="shopping-cart"></i>
                <span>
                    <%= totalProdutos || 0 %> produtos
                </span>
            </div>
        </div>
    </section>

    <!-- Grid de Produtos -->
    <main class="catalog-container">
        <div class="products-grid-catalog">
            <% if (produtos && produtos.length> 0) { %>
                <% produtos.forEach(produto=> { %>
                    <article class="product-card-catalog">
                        <div class="product-card-image">
                            <img src="<%= produto.imagem_url || '/img/placeholder-phone.png' %>"
                                alt="<%= produto.nome %>">
                        </div>
                        <div class="product-card-body">
                            <h3 class="product-card-title">
                                <%= produto.nome %>
                            </h3>
                            <p class="product-card-price">
                                <%= Number(produto.preco).toLocaleString('pt-BR', { style: 'currency' , currency: 'BRL'
                                    }) %>
                            </p>
                            <p class="product-card-condition">
                                Condição: <strong>
                                    <%= produto.condicao || 'Excelente' %>
                                </strong>
                            </p>
                            <div class="product-card-actions">
                                <button class="btn-icon" title="Adicionar aos Favoritos">
                                    <i data-lucide="heart"></i>
                                </button>
                                <button class="btn-icon" title="Adicionar ao Carrinho">
                                    <i data-lucide="shopping-cart"></i>
                                </button>
                            </div>
                        </div>
                    </article>
                    <% }) %>
                        <% } else { %>
                            <p class="no-products">Nenhum produto encontrado.</p>
                            <% } %>
        </div>
    </main>

    <script>
        lucide.createIcons();
    </script>
</body>

</html>