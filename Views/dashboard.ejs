<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VoltTech - Dashboard Admin</title>
    <link rel="shortcut icon" type="image/x-icon" href="/img/adm_favicon.ico">

    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/dashboard.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

<body class="admin-body">

    <header class="navbar navbar-admin">
        <div class="logo">
            <a href="/admin/dashboard">
                <img src="/img/VoltTech.png" alt="Logo VoltTech" class="logo-icon"
                    onerror="this.src='https://via.placeholder.com/40'">
                <div>
                    <h1>VoltTech</h1>
                    <span class="sub-logo">Dashboard</span>
                </div>
            </a>
        </div>
        <div class="admin-header-right">
            <nav class="nav-links-admin">
                <a href="/admin/categorias">Categorias</a>
                <a href="/admin/produtos">Estoque</a>
                <a href="/admin/usuarios">Usuários</a>
                <a href="/admin/contato">Fale Conosco</a>
            </nav>
            <span class="user-greeting">Bem-vindo, <strong>Administrador</strong></span>
            <a href="/logout" class="nav-item sair" title="Sair">
                <i class="fa-solid fa-arrow-right-from-bracket"></i>
            </a>
        </div>
    </header>

    <main class="dashboard-container">

        <!-- 1. Cards de Métricas Superiores -->
        <section class="metrics-grid">
            <div class="metric-card">
                <p class="metric-label">Vendas no mês</p>
                <h2 class="metric-value">
                    <%= Number(vendasMes || 24500).toLocaleString('pt-BR', { style: 'currency' , currency: 'BRL' }) %>
                </h2>
            </div>
            <div class="metric-card">
                <p class="metric-label">Pedidos</p>
                <h2 class="metric-value">
                    <%= totalPedidos || 0 %>
                </h2>
            </div>
            <div class="metric-card">
                <p class="metric-label">Produtos cadastrados</p>
                <h2 class="metric-value">
                    <%= totalProdutos || 0 %>
                </h2>
            </div>
        </section>

        <!-- 2. Gráfico e Alertas de Estoque -->
        <section class="dashboard-content">
            <div class="dashboard-card chart-card">
                <h3>Vendas nos últimos 30 dias</h3>
                <div class="chart-container" style="position: relative; height: 280px;">
                    <canvas id="vendasChart"></canvas>
                </div>
            </div>

            <div class="dashboard-card stock-card">
                <h3>Atenção: <span>Alto estoque</span></h3>
                <ul class="stock-list">
                    <% if (produtosAltoEstoque && produtosAltoEstoque.length> 0) { %>
                        <% produtosAltoEstoque.forEach(item=> { %>
                            <li class="stock-item">
                                <div class="stock-info">
                                    <strong>
                                        <%= item.nome %>
                                    </strong>
                                </div>
                                <div class="stock-qty">
                                    <span>Qtd: <strong>
                                            <%= item.quantidade %>
                                        </strong></span>
                                </div>
                            </li>
                            <% }) %>
                                <% } else { %>
                                    <li class="stock-item">Nenhum alerta de estoque.</li>
                                    <% } %>
                </ul>
            </div>
        </section>

        <!-- 3. Movimentações Recentes e Gerenciamento de Administradores -->
        <section class="dashboard-content">

            <!-- BLOCO DE MOVIMENTAÇÕES CORRIGIDO -->
            <div class="dashboard-card">
                <h3>Últimas <span>Movimentações</span></h3>
                <ul class="stock-list">
                    <% if (movimentacoes && movimentacoes.length> 0) { %>
                        <% movimentacoes.forEach(mov=> { %>
                            <li class="stock-item">
                                <div class="stock-info">
                                    <strong>
                                        <%= mov.produto || mov.produto_nome || mov.nome || 'Produto Sem Nome' %>
                                    </strong>
                                    <small>
                                        <%= mov.criado_em ? new Date(mov.criado_em).toLocaleDateString('pt-BR')
                                            : 'Data n/a' %>
                                    </small>
                                </div>
                                <div class="stock-qty">
                                    <span
                                        class="badge-mov <%= (mov.tipo && mov.tipo.toLowerCase() === 'entrada') ? 'badge-entrada' : 'badge-saida' %>">
                                        <%= (mov.tipo && mov.tipo.toLowerCase()==='entrada' ) ? '+' : '-' %>
                                            <%= mov.quantidade || 0 %> un
                                    </span>
                                </div>
                            </li>
                            <% }) %>
                                <% } else { %>
                                    <li class="stock-item">Nenhuma movimentação registrada.</li>
                                    <% } %>
                </ul>
            </div>

            <div class="dashboard-card">
                <h3>Gerenciamento de <span>Administradores</span></h3>
                <form action="/admin/usuarios/salvar" method="POST" class="form-grid-admin">
                    <input type="text" name="nome" placeholder="Nome Completo" required class="input-dash">
                    <input type="email" name="email" placeholder="E-mail" required class="input-dash">
                    <input type="password" name="senha" placeholder="Senha" required class="input-dash">
                    <button type="submit" class="btn-criar-admin">Criar Admin</button>
                </form>

                <h4 class="users-list-title">Administradores Cadastrados</h4>
                <ul class="stock-list">
                    <% if (usuarios && usuarios.length> 0) { %>
                        <% usuarios.forEach(u=> { %>
                            <li class="stock-item">
                                <div class="stock-info">
                                    <strong>
                                        <%= u.nome %>
                                    </strong>
                                    <small>
                                        <%= u.email %>
                                    </small>
                                </div>
                                <span class="badge-admin">Ativo</span>
                            </li>
                            <% }) %>
                                <% } else { %>
                                    <li class="stock-item">Nenhum administrador cadastrado.</li>
                                    <% } %>
                </ul>
            </div>

        </section>

    </main>

    <script>
        const ctx = document.getElementById('vendasChart').getContext('2d');
        new Chart(ctx, {
            type: 'line',
            data: {
                labels: ['Celular', 'Notebook', 'Desktop', 'Telinha', 'Smartwatch', 'Áudio', 'Monitores'],
                datasets: [{
                    label: 'Vendas',
                    data: [180, 290, 220, 200, 205, 180, 50],
                    borderColor: '#1bbbe1',
                    backgroundColor: 'rgba(27, 187, 225, 0.1)',
                    borderWidth: 2,
                    tension: 0.3,
                    pointBackgroundColor: '#1bbbe1'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    y: { beginAtZero: true, grid: { color: '#f1f5f9' } },
                    x: { grid: { display: false } }
                }
            }
        });
    </script>
</body>

</html>