<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VoltTech - Editar produto</title>
    <link rel="shortcut icon" type="image/x-icon" href="/img/adm_favicon.ico">

    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/dashboard.css">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

<body class="admin-body">
    <header class="navbar navbar-admin">
        <div class="logo">
            <a href="/admin/dashboard">
                <img src="/img/VoltTech.png" alt="VoltTech" class="logo-icon"
                    onerror="this.src='https://via.placeholder.com/40'">
                <div>
                    <h1>VoltTech</h1>
                    <span class="sub-logo">Editar produto</span>
                </div>
            </a>
        </div>
        <div class="admin-header-right">
            <nav class="nav-links-admin">
                <a href="/admin/categorias">Categorias</a>
                <a href="/admin/produtos">Estoque</a>
                <a href="/admin/usuarios">Usuários</a>
                <a href="/admin/contato">Fale Conosco</a>
            </nav>
            <span class="user-greeting">Bem-vindo, <strong>Administrador</strong></span>
            <a href="/logout" class="nav-item sair">
                <i class="fa-solid fa-arrow-right-from-bracket"></i>
            </a>
        </div>
    </header>

    <main class="dashboard-container" style="margin-top: 40px; padding-bottom: 40px;">
        <div class="dashboard-card form-card-large">
            <form action="/admin/produtos/editar/<%= produto.id %>" method="POST" class="admin-form">
                <div class="form-group">
                    <label>Nome do produto</label>
                    <input type="text" name="nome" value="<%= produto.nome %>" required class="input-dash">
                </div>

                <div class="form-group">
                    <label>Marca</label>
                    <input type="text" name="marca" value="<%= produto.marca || '' %>" required class="input-dash">
                </div>

                <div class="form-group">
                    <label>Categoria</label>
                    <select name="categoria_id" class="input-dash">
                        <option value="">Selecione uma categoria...</option>
                        <% if (typeof categorias !=='undefined' && categorias && categorias.length> 0) { %>
                            <% categorias.forEach(function(c) { %>
                                <option value="<%= c.id %>" <%=Number(produto.categoria_id)===Number(c.id) ? 'selected'
                                    : '' %>>
                                    <%= c.nome %>
                                </option>
                                <% }); %>
                                    <% } %>
                    </select>
                </div>

                <div class="form-group">
                    <label>Valor (R$)</label>
                    <input type="number" step="0.01" name="preco" value="<%= produto.preco %>" required
                        class="input-dash">
                </div>

                <div class="form-row-2">
                    <div class="form-group">
                        <label>Quantidade</label>
                        <input type="number" name="quantidade" value="<%= produto.quantidade %>" required
                            class="input-dash">
                    </div>
                    <div class="form-group">
                        <label>Quantidade mínima</label>
                        <input type="number" name="qtd_minima" value="<%= produto.qtd_minima || 5 %>"
                            class="input-dash">
                    </div>
                </div>

                <!-- Campo de Imagem com Drag and Drop -->
                <div class="form-group">
                    <label>Imagem do Produto</label>
                    <div id="dropZone" class="label-insert">
                        <i class="fa-solid fa-cloud-arrow-up"></i>
                        <span id="dropText" class="label-insert-text">Arraste uma nova imagem para substituir ou 
                        <strong class="label-insert-text bold">clique para selecionar</strong></span>
                        <input type="file" id="fileInput" accept="image/*" style="display: none;">
                    </div>

                    <div id="previewContainer"
                        style="margin-top: 12px; display: <%= produto.imagem_url ? 'block' : 'none' %>; text-align: center;">
                        <img id="imgPreview" src="<%= produto.imagem_url || '' %>" alt="Pré-visualização"
                            style="max-width: 150px; max-height: 150px; border-radius: 6px; border: 1px solid #1bbbe1;">
                    </div>

                    <input type="hidden" name="imagem_url" id="imagem_url" value="<%= produto.imagem_url || '' %>">
                </div>

                <div class="form-group">
                    <label>Condição</label>
                    <div class="segmented-control">
                        <label>
                            <input type="radio" name="condicao" value="Excelente" <%=produto.condicao==='Excelente'
                                ? 'checked' : '' %>>
                            <span>Excelente</span>
                        </label>
                        <label>
                            <input type="radio" name="condicao" value="Bom" <%=(produto.condicao==='Muito bom' ||
                                produto.condicao==='Bom' ) ? 'checked' : '' %>>
                            <span>Bom</span>
                        </label>
                        <label>
                            <input type="radio" name="condicao" value="Aceitável" <%=produto.condicao==='Aceitável'
                                ? 'checked' : '' %>>
                            <span>Aceitável</span>
                        </label>
                    </div>
                </div>

                <div class="form-actions-right">
                    <a href="/admin/produtos" class="btn-cancelar">Cancelar</a>
                    <button type="submit" class="btn-salvar">Salvar alterações</button>
                </div>
            </form>
        </div>
    </main>

    <script>
        const dropZone = document.getElementById('dropZone');
        const fileInput = document.getElementById('fileInput');
        const dropText = document.getElementById('dropText');
        const imagemInput = document.getElementById('imagem_url');
        const imgPreview = document.getElementById('imgPreview');
        const previewContainer = document.getElementById('previewContainer');

        dropZone.addEventListener('click', () => fileInput.click());

        ['dragover', 'dragenter'].forEach(evt => {
            dropZone.addEventListener(evt, (e) => {
                e.preventDefault();
                dropZone.style.borderColor = '#1bbbe1';
            });
        });

        ['dragleave', 'drop'].forEach(evt => {
            dropZone.addEventListener(evt, (e) => {
                e.preventDefault();
                dropZone.style.borderColor = '#64748b';
            });
        });

        dropZone.addEventListener('drop', (e) => {
            const files = e.dataTransfer.files;
            if (files.length > 0) processarImagem(files[0]);
        });

        fileInput.addEventListener('change', () => {
            if (fileInput.files.length > 0) processarImagem(fileInput.files[0]);
        });

        function processarImagem(file) {
            if (!file.type.startsWith('image/')) {
                alert('Por favor, selecione apenas arquivos de imagem!');
                return;
            }

            const reader = new FileReader();
            reader.onload = function (e) {
                const base64String = e.target.result;
                imagemInput.value = base64String;
                imgPreview.src = base64String;
                previewContainer.style.display = 'block';
                dropText.innerHTML = `Nova imagem selecionada: <strong>${file.name}</strong>`;
            };
            reader.readAsDataURL(file);
        }
    </script>
</body>

</html>