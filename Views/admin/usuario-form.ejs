<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VoltTech - Cadastro de Usuário</title>
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/dashboard.css">
</head>

<body class="admin-body">

    <header class="navbar navbar-admin">
        <div class="logo">
            <a href="/admin/dashboard">
                <img src="/img/VoltTech.png" alt="VoltTech" class="logo-icon"
                    onerror="this.src='https://via.placeholder.com/40'">
                <div>
                    <h1>VoltTech</h1>
                    <span class="sub-logo">Usuários</span>
                </div>
            </a>
        </div>
        <div class="admin-header-right">
            <nav class="nav-links-admin">
                <a href="/admin/categorias">Categorias</a>
                <a href="/admin/produtos">Estoque</a>
                <a href="/admin/usuarios" class="active">Usuários</a>
                <a href="/admin/contato">Fale Conosco</a>
                <a href="/logout" class="btn-logout">Sair</a>
            </nav> 
            <span class="user-greeting">Bem-vindo, <strong><%= usuarioLogado ? usuarioLogado.nome : 'Administrador' %></strong></span>
        </div>
    </header>

    <main class="dashboard-container">
        <div class="dashboard-card form-card-large">
            <h2 style="color: #0b7c93; margin-bottom: 20px; font-size: 1.3rem;">Cadastrar Novo Usuário</h2>

            <form action="/admin/usuarios/salvar" method="POST" class="admin-form" style="display: flex; flex-direction: column; gap: 16px;">
                <div class="form-group">
                    <label style="font-size: 0.85rem; color: #334155; font-weight: 600; display: block; margin-bottom: 6px;">Nome Completo</label>
                    <input type="text" name="nome" placeholder="Ex: João Silva" required class="input-dash">
                </div>

                <div class="form-group">
                    <label style="font-size: 0.85rem; color: #334155; font-weight: 600; display: block; margin-bottom: 6px;">E-mail</label>
                    <input type="email" name="email" placeholder="Ex: joao@volttech.com.br" required class="input-dash">
                </div>

                <div class="form-group">
                    <label style="font-size: 0.85rem; color: #334155; font-weight: 600; display: block; margin-bottom: 6px;">Senha</label>
                    <input type="password" name="senha" placeholder="••••••••" required class="input-dash">
                </div>

                <div class="form-group">
                    <label style="font-size: 0.85rem; color: #334155; font-weight: 600; display: block; margin-bottom: 6px;">Condição / Status</label>
                    <div class="segmented-control">
                        <label>
                            <input type="radio" name="situacao" value="Ativo" checked> 
                            <span>Ativo</span>
                        </label>
                        <label>
                            <input type="radio" name="situacao" value="Inativo"> 
                            <span>Inativo</span>
                        </label>
                    </div>
                </div>

                <div class="form-actions-right">
                    <a href="/admin/usuarios" class="btn-cancelar">Cancelar</a>
                    <button type="submit" class="btn-salvar">Salvar Usuário</button>
                </div>
            </form>
        </div>
    </main>

</body>

</html>