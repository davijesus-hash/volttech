<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VoltTech - Cadastro de categorias</title>
    <link rel="shortcut icon" type="image/x-icon" href="/img/adm_favicon.ico">

    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/dashboard.css">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

<body class="admin-body">
    <header class="navbar navbar-admin">
        <div class="logo">
            <a href="/admin/dashboard">
                <img src="/img/VoltTech.png" alt="VoltTech" class="logo-icon"
                    onerror="this.src='https://via.placeholder.com/40'">
                <div>
                    <h1>VoltTech</h1>
                    <span class="sub-logo">Cadastro de categorias</span>
                </div>
            </a>
        </div>
        <div class="admin-header-right">
            <nav class="nav-links-admin">
                <a href="/admin/categorias">Categorias</a>
                <a href="/admin/produtos">Estoque</a>
                <a href="/admin/usuarios">Usuários</a>
                <a href="/admin/contato">Fale Conosco</a>
            </nav>
            <span class="user-greeting">Bem-vindo, <strong>Administrador</strong></span>
            <a href="/logout" class="nav-item sair">
                <i class="fa-solid fa-arrow-right-from-bracket"></i>
            </a>
            </nav>
        </div>
    </header>

    <main class="dashboard-container">
        <div class="dashboard-card form-card-large">
            <form action="/admin/categorias/salvar" method="POST" class="admin-form">
                <div class="form-group">
                    <label>Nome da categoria</label>
                    <input type="text" name="nome" placeholder="Ex: Celular" required class="input-dash">
                </div>

                <div class="form-group">
                    <label>Descrição</label>
                    <input type="text" name="descricao" placeholder="Ex: Smartphones e acessórios" class="input-dash">
                </div>

                <div class="form-group">
                    <label>URL da Imagem</label>
                    <input type="url" name="imagem_url" placeholder="https://exemplo.com/imagem.png" class="input-dash">
                </div>

                <div class="form-actions-right">
                    <a href="/admin/categorias" class="btn-cancelar">Cancelar</a>
                    <button type="submit" class="btn-salvar">Salvar</button>
                </div>
            </form>
        </div>
    </main>
</body>

</html>