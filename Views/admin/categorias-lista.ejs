<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VoltTech - Categorias</title>

    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/dashboard.css">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

<body class="admin-body">
    <header class="navbar navbar-admin">
        <div class="logo">
            <a href="/admin/dashboard">
                <img src="/img/VoltTech.png" alt="VoltTech" class="logo-icon"
                    onerror="this.src='https://via.placeholder.com/40'">
                <div>
                    <h1>VoltTech</h1>
                    <span class="sub-logo">Categorias</span>
                </div>
            </a>
        </div>
        <div class="admin-header-right">
            <nav class="nav-links-admin">
                <a href="/admin/categorias" class="active">Categorias</a>
                <a href="/admin/produtos">Estoque</a>
                <a href="/admin/usuarios">Usuários</a>
                <a href="/admin/contato">Fale Conosco</a>
            </nav>
            <span class="user-greeting">Bem-vindo, <strong>Administrador</strong></span>
            <a href="/logout" class="nav-item sair">
                <i class="fa-solid fa-arrow-right-from-bracket"></i>
            </a>
        </div>
    </header>

    <main class="dashboard-container">
        <div class="header-action-row">
            <a href="/admin/categorias/nova" class="btn-primary-action">Criar categorias</a>
        </div>

        <div class="dashboard-card table-card">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>NOME</th>
                        <th>DESCRIÇÃO</th>
                        <th class="text-right">AÇÕES</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (categorias && categorias.length> 0) { %>
                        <% categorias.forEach(c=> { %>
                            <tr>
                                <td>
                                    <%= c.id %>
                                </td>
                                <td><strong>
                                        <%= c.nome %>
                                    </strong></td>
                                <td>
                                    <%= c.descricao || '-' %>
                                </td>
                                <td class="text-right">
                                    <a href="/admin/categorias/editar/<%= c.id %>" class="btn-table-edit">Editar</a>
                                </td>
                            </tr>
                            <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="4" class="text-center">Nenhuma categoria cadastrada.</td>
                                    </tr>
                                    <% } %>
                </tbody>
            </table>
        </div>
    </main>
</body>

</html>