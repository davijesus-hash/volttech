<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VoltTech - Usuários</title>
    <link rel="shortcut icon" type="image/x-icon" href="/img/adm_favicon.ico">

    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/dashboard.css">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

<body class="admin-body">
    <header class="navbar navbar-admin">
        <div class="logo">
            <a href="/admin/dashboard">
                <img src="/img/VoltTech.png" alt="VoltTech" class="logo-icon"
                    onerror="this.src='https://via.placeholder.com/40'">
                <div>
                    <h1>VoltTech</h1>
                    <span class="sub-logo">Usuários</span>
                </div>
            </a>
        </div>
        <div class="admin-header-right">
            <nav class="nav-links-admin">
                <a href="/admin/categorias">Categorias</a>
                <a href="/admin/produtos">Estoque</a>
                <a href="/admin/usuarios" class="active">Usuários</a>
                <a href="/admin/contato">Fale Conosco</a>
            </nav>
            <span class="user-greeting">Bem-vindo, <strong>Administrador</strong></span>
            <a href="/logout" class="nav-item sair">
                <i class="fa-solid fa-arrow-right-from-bracket"></i>
            </a>
        </div>
    </header>

    <main class="dashboard-container">
        <div class="header-action-row">
            <a href="/admin/usuarios/novo" class="btn-primary-action">Criar usuário</a>
        </div>

        <div class="dashboard-card table-card">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>NOME</th>
                        <th>E-MAIL</th>
                        <th>SITUAÇÃO</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (usuarios && usuarios.length> 0) { %>
                        <% usuarios.forEach(u=> { %>
                            <tr>
                                <td>
                                    <%= u.id %>
                                </td>
                                <td><strong>
                                        <%= u.nome %>
                                    </strong></td>
                                <td>
                                    <%= u.email %>
                                </td>
                                <td>
                                    <span
                                        class="badge-status <%= u.situacao === 'Inativo' ? 'status-inativo' : 'status-ativo' %>">
                                        <%= u.situacao || 'Ativo' %>
                                    </span>
                                </td>
                            </tr>
                            <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="4" class="text-center">Nenhum usuário cadastrado.</td>
                                    </tr>
                                    <% } %>
                </tbody>
            </table>
        </div>
    </main>
</body>

</html>